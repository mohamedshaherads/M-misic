#!/bin/sh
# Lightweight Gradle bootstrapper for this repository.
# Downloads the pinned Gradle distribution if it is not already installed.
set -eu
GRADLE_VERSION="8.9"
GRADLE_HOME="${GRADLE_USER_HOME:-$HOME/.gradle}/manual-gradle/gradle-${GRADLE_VERSION}"
if [ -x "$GRADLE_HOME/bin/gradle" ]; then
  exec "$GRADLE_HOME/bin/gradle" "$@"
fi
BASE="${GRADLE_USER_HOME:-$HOME/.gradle}/manual-gradle"
ZIP="$BASE/gradle-${GRADLE_VERSION}-bin.zip"
mkdir -p "$BASE"
if [ ! -f "$ZIP" ]; then
  if command -v curl >/dev/null 2>&1; then
    curl -fL --retry 3 "https://services.gradle.org/distributions/gradle-${GRADLE_VERSION}-bin.zip" -o "$ZIP"
  elif command -v wget >/dev/null 2>&1; then
    wget -O "$ZIP" "https://services.gradle.org/distributions/gradle-${GRADLE_VERSION}-bin.zip"
  else
    echo "Please install curl or wget to download Gradle." >&2
    exit 1
  fi
fi
unzip -oq "$ZIP" -d "$BASE"
exec "$GRADLE_HOME/bin/gradle" "$@"
